# Controlled GRPO group-size ablation after the outcome-only 200-step run.
# Each update has one prompt and four trajectories for that same prompt.  With
# 200 updates this consumes 200 prompts and 800 rollouts, matching the prior
# batch=2, n_agent=2 experiment's total rollout budget.

export GRPO_RUN_LABEL=grpo_flat_rag_outcome_em_nagent4_batch1_200step
export GRPO_TRAIN_DATA_NUM=200
export GRPO_VAL_DATA_NUM=50
export GRPO_TRAIN_BATCH_SIZE=1
export GRPO_VAL_BATCH_SIZE=2
export GRPO_TOTAL_STEPS=200
export GRPO_SHUFFLE_TRAIN_DATALOADER=false
export GRPO_PYTHONHASHSEED=1000

# The policy can answer directly or make at most two searches.
export GRPO_MAX_PROMPT_LENGTH=1024
export GRPO_MAX_RESPONSE_LENGTH=128
export GRPO_MAX_START_LENGTH=2048
export GRPO_MAX_OBS_LENGTH=640
export GRPO_MAX_TURNS=2
export GRPO_N_AGENTS=4

# Keep the outcome-only reward unchanged.  Lower LR after the prior run's
# rising KL and protocol degradation; this run therefore tests group size plus
# a deliberately conservative stability adjustment.
export GRPO_LEARNING_RATE=2e-7
export GRPO_STRUCTURE_FORMAT_SCORE=0.0
export GRPO_FINAL_FORMAT_SCORE=0.0
export GRPO_RETRIEVAL_SCORE=0.0

# Validated one-A800 memory profile with the 60 GiB Flat index in host RAM.
export GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.30
export GRPO_PARAM_OFFLOAD=false
export GRPO_GRAD_OFFLOAD=false
export GRPO_OPTIMIZER_OFFLOAD=false
export GRPO_REF_PARAM_OFFLOAD=true

# The trainer guarantees a final actor save before final validation whenever
# saving is enabled.  Verify the log and actor/global_step_200 after the run.
export GRPO_TEST_FREQ=100
export GRPO_SAVE_FREQ=200
