# Same settings as the outcome-only 1,000-step run, except for the requested
# 600-update budget and the enabled format reward.

export GRPO_RUN_LABEL=grpo_flat_rag_outcome_em_format_nagent4_batch1_600step
export GRPO_TRAIN_DATA_NUM=1000
export GRPO_VAL_DATA_NUM=50
export GRPO_TRAIN_BATCH_SIZE=1
export GRPO_VAL_BATCH_SIZE=2
export GRPO_TOTAL_STEPS=600
export GRPO_SHUFFLE_TRAIN_DATALOADER=false
export GRPO_PYTHONHASHSEED=1000

export GRPO_MAX_PROMPT_LENGTH=1024
export GRPO_MAX_RESPONSE_LENGTH=128
export GRPO_MAX_START_LENGTH=2048
export GRPO_MAX_OBS_LENGTH=640
export GRPO_MAX_TURNS=2
export GRPO_N_AGENTS=4

export GRPO_LEARNING_RATE=2e-7
export GRPO_STRUCTURE_FORMAT_SCORE=0.2
export GRPO_FINAL_FORMAT_SCORE=0.1
export GRPO_RETRIEVAL_SCORE=0.0

export GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.30
export GRPO_PARAM_OFFLOAD=false
export GRPO_GRAD_OFFLOAD=false
export GRPO_OPTIMIZER_OFFLOAD=false
export GRPO_REF_PARAM_OFFLOAD=true

# Retain only global_step_500.  The final-update save is disabled because the
# 20 GiB disk cannot hold a second ~13 GiB actor checkpoint at step 600.
export GRPO_TEST_FREQ=500
export GRPO_SAVE_FREQ=500
export GRPO_SAVE_FINAL_CHECKPOINT=false
