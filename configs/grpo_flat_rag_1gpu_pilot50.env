# Fixed 50-step GRPO pilot using the complete local Flat FAISS Wiki-18 RAG.
# The first 100 NQ training rows and first 50 validation rows are deliberately
# kept in order so that this run has a stable data slice.

export GRPO_RUN_LABEL=grpo_flat_rag_1gpu_pilot50
export GRPO_TRAIN_DATA_NUM=100
export GRPO_VAL_DATA_NUM=50
export GRPO_TRAIN_BATCH_SIZE=2
export GRPO_VAL_BATCH_SIZE=2
export GRPO_TOTAL_STEPS=50
export GRPO_SHUFFLE_TRAIN_DATALOADER=false
export GRPO_PYTHONHASHSEED=1000

export GRPO_MAX_PROMPT_LENGTH=1024
export GRPO_MAX_RESPONSE_LENGTH=128
export GRPO_MAX_START_LENGTH=2048
export GRPO_MAX_OBS_LENGTH=640
export GRPO_MAX_TURNS=2
export GRPO_N_AGENTS=2

export GRPO_LEARNING_RATE=5e-7
export GRPO_STRUCTURE_FORMAT_SCORE=0.2
export GRPO_FINAL_FORMAT_SCORE=0.1
export GRPO_RETRIEVAL_SCORE=0.1

# Preserve host RAM for the 60 GiB Flat index.  The 80 GiB A800 retains the
# optimizer state while vLLM reserves only a small KV cache.
export GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.30
export GRPO_PARAM_OFFLOAD=false
export GRPO_GRAD_OFFLOAD=false
export GRPO_OPTIMIZER_OFFLOAD=false
export GRPO_REF_PARAM_OFFLOAD=true

# A full FSDP checkpoint can exceed the currently available 20 GiB.  Keep the
# pilot disk-safe and retain its resolved Hydra config, offline W&B run, and
# metrics log instead.
export GRPO_SAVE_FREQ=-1
export GRPO_TEST_FREQ=25
