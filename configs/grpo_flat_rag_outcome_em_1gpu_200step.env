# First controlled outcome-only GRPO experiment on local Flat FAISS Wiki-18 RAG.
# The trainer samples a deterministic 400-row subset (random_state=42); with
# batch=2 and one epoch, this provides exactly 200 optimizer updates.

export GRPO_RUN_LABEL=grpo_flat_rag_outcome_em_1gpu_200step
export GRPO_TRAIN_DATA_NUM=400
export GRPO_VAL_DATA_NUM=50
export GRPO_TRAIN_BATCH_SIZE=2
export GRPO_VAL_BATCH_SIZE=2
export GRPO_TOTAL_STEPS=200
export GRPO_SHUFFLE_TRAIN_DATALOADER=false
export GRPO_PYTHONHASHSEED=1000

# A policy may decide to finish after 0, 1, or 2 search turns.
export GRPO_MAX_PROMPT_LENGTH=1024
export GRPO_MAX_RESPONSE_LENGTH=128
export GRPO_MAX_START_LENGTH=2048
export GRPO_MAX_OBS_LENGTH=640
export GRPO_MAX_TURNS=2
export GRPO_N_AGENTS=2

# Outcome-only reward: exact-match answer = 1.0, every other outcome = 0.0.
# Tags remain necessary to extract the final answer; they are not rewarded.
export GRPO_LEARNING_RATE=5e-7
export GRPO_STRUCTURE_FORMAT_SCORE=0.0
export GRPO_FINAL_FORMAT_SCORE=0.0
export GRPO_RETRIEVAL_SCORE=0.0

# Validated one-A800 memory profile with the 60 GiB Flat index in host RAM.
export GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.30
export GRPO_PARAM_OFFLOAD=false
export GRPO_GRAD_OFFLOAD=false
export GRPO_OPTIMIZER_OFFLOAD=false
export GRPO_REF_PARAM_OFFLOAD=true

# Validate at the midpoint; write only the final actor checkpoint. The actor
# weights need roughly 6--8 GiB, which fits in the current 20 GiB free space.
export GRPO_TEST_FREQ=100
export GRPO_SAVE_FREQ=200
