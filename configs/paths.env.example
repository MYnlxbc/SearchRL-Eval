# SearchRL-Eval 路径配置
# 不要在此文件中放 Token、密码等敏感信息。

export SEARCHRL_ROOT="${SEARCHRL_ROOT:-/root/autodl-tmp/searchrl_eval}"
export EVAL_REPO_DIR="${EVAL_REPO_DIR:-${SEARCHRL_ROOT}/SearchRL-Eval}"
export SEARCHR1_CODE_DIR="${SEARCHR1_CODE_DIR:-${SEARCHRL_ROOT}/Search-R1}"

export MODEL_PATH="${MODEL_PATH:-${SEARCHRL_ROOT}/models/Qwen2.5-3B-Instruct}"
export RETRIEVER_MODEL_PATH="${RETRIEVER_MODEL_PATH:-${SEARCHRL_ROOT}/models/e5-base-v2}"

export QA_DATA_DIR="${QA_DATA_DIR:-${SEARCHRL_ROOT}/datasets/raw/nq_hotpotqa_train}"
export INDEX_PATH="${INDEX_PATH:-${SEARCHRL_ROOT}/retrieval/e5_Flat.index}"
export CORPUS_PATH="${CORPUS_PATH:-${SEARCHRL_ROOT}/retrieval/wiki-18.jsonl}"

export OUTPUT_DIR="${OUTPUT_DIR:-${EVAL_REPO_DIR}/outputs}"
export LOG_DIR="${LOG_DIR:-${EVAL_REPO_DIR}/logs}"

export RETRIEVER_HOST="${RETRIEVER_HOST:-127.0.0.1}"
export RETRIEVER_PORT="${RETRIEVER_PORT:-8000}"
export RETRIEVER_TOPK="${RETRIEVER_TOPK:-3}"

# 单卡默认让 FAISS 索引留在 CPU 内存，只让 E5 编码器使用 GPU。
# 否则约 60 GiB 的 Flat 索引会占据绝大部分 A800 显存。
export FAISS_GPU="${FAISS_GPU:-0}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

export RETRIEVER_URL="${RETRIEVER_URL:-http://${RETRIEVER_HOST}:${RETRIEVER_PORT}/retrieve}"
