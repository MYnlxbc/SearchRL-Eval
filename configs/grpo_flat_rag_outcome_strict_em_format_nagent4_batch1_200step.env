# Controlled second-round GRPO experiment: Strict EM outcome + format reward.
# Training is a deterministic 100 NQ / 100 HotpotQA mixture, built by
# scripts/18_make_balanced_nq_hotpot_subset.py.

export GRPO_RUN_LABEL=grpo_flat_rag_outcome_strict_em_format_nagent4_batch1_200step
# Set QA_DATA_DIR in the shell or in the local configs/paths.env file.
export GRPO_TRAIN_DATA_NUM=200
export GRPO_VAL_DATA_NUM=100
export GRPO_TRAIN_BATCH_SIZE=1
export GRPO_VAL_BATCH_SIZE=2
export GRPO_TOTAL_STEPS=200
export GRPO_SHUFFLE_TRAIN_DATALOADER=false
export GRPO_PYTHONHASHSEED=20260821

export GRPO_MAX_PROMPT_LENGTH=1024
export GRPO_MAX_RESPONSE_LENGTH=128
export GRPO_MAX_START_LENGTH=2048
export GRPO_MAX_OBS_LENGTH=640
export GRPO_MAX_TURNS=2
export GRPO_N_AGENTS=4

# Outcome + format shaping.  In qa_em_format.py this produces:
# valid Strict EM = 1.0; correct answer with invalid structure = 0.8;
# valid structure but wrong/unanswered = 0.2; invalid final answer = 0.1.
# Retrieval evidence bonus remains disabled for this one-variable ablation.
export GRPO_LEARNING_RATE=2e-7
export GRPO_STRUCTURE_FORMAT_SCORE=0.2
export GRPO_FINAL_FORMAT_SCORE=0.1
export GRPO_RETRIEVAL_SCORE=0.0

export GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.30
export GRPO_PARAM_OFFLOAD=false
export GRPO_GRAD_OFFLOAD=false
export GRPO_OPTIMIZER_OFFLOAD=false
export GRPO_REF_PARAM_OFFLOAD=true

# Exactly one final checkpoint (~13 GiB), after the last update.
export GRPO_TEST_FREQ=100
export GRPO_SAVE_FREQ=200
